{
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-env --allow-write mod.ts",
    "dev": "deno run --allow-net --allow-read --allow-env --allow-write --watch mod.ts",
    "test": "deno test --allow-net --allow-read --allow-env",
    "migrate:up": "deno run --allow-net --allow-read --allow-env --allow-write src/db/migrations/run.ts up",
    "migrate:down": "deno run --allow-net --allow-read --allow-env --allow-write src/db/migrations/run.ts down"
  },
  "importMap": "./import_map.json",
  "compilerOptions": {
    "strict": true
  },
  "lint": {
    "include": ["src/", "mod.ts", "deps.ts"],
    "exclude": ["src/testdata/", "data/fixtures/**/*.ts"],
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "include": ["src/", "mod.ts", "deps.ts"],
    "exclude": ["src/testdata/", "data/fixtures/**/*.ts"],
    "indentWidth": 2,
    "lineWidth": 100,
    "singleQuote": false,
    "useTabs": false
  }
}